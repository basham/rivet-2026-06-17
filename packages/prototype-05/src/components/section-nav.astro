---
const { menu: _menu } = Astro.props;
const menu = _menu.hasChildren ? _menu : _menu.getParent();
const parent = menu.getParent();
---

<rvt-prototype-section-nav type={menu.main ? "main" : null}>
	{menu.depth > 1 && (
		<>
			<a href={parent.url}>
				<rvt-icon name="chevron-left"></rvt-icon>
				Back
			</a>
			<a
				aria-current={menu.current ? "page" : null}
				data-current={menu.hasCurrent ? true : null}
				href={menu.url}
			>
				{menu.label}
			</a>
		</>
	)}
	<ul>
		{menu.items.map((item: any) => (
			<li>
				<a
					aria-current={item.current ? "page" : null}
					href={item.url}
				>
					{item.label}
					{item.hasChildren && (
						<rvt-icon name="chevron-right"></rvt-icon>
					)}
				</a>
			</li>
		))}
	</ul>
</rvt-prototype-section-nav>

<style is:global>
	rvt-prototype-section-nav {
		display: flex;
		flex-direction: column;
		gap: var(--rvt-size-8);
		padding: var(--rvt-size-16) 0 0 var(--rvt-size-20);

		> a {
			justify-content: unset;

			&:has(rvt-icon) {
				font: var(--rvt-font-14);
				gap: var(--rvt-size-4);
				padding-block: var(--rvt-size-2);
				margin-inline-start: calc(var(--rvt-size-20) * -1);
			}
		}

		ul {
			gap: var(--rvt-size-8);

			&:not(:first-child) {
				padding-inline-start: var(--rvt-size-20);
			}
		}
	}
</style>
