---
const { menu: _menu } = Astro.props;
const menu = _menu.hasChildren ? _menu : _menu.getParent();
const parent = menu.getParent();
---

<rvt-prototype-section-nav type={menu.main ? "main" : null}>
	<nav aria-label="Section nav">
		{parent && (
			<a href={parent.url}>
				<rvt-icon name="arrow-left"></rvt-icon>
				{parent.id === "main" ? "Home" : parent.label}
			</a>
		)}
		{!menu.main && (
			<h2>
				{menu.current && menu.label}
				{!menu.current && (
					<a href={menu.url}>
						{menu.label}
					</a>
				)}
			</h2>
		)}
		<ul>
			{menu.items.map((item: any, i: number) => (
				<li>
					<a
						aria-current={item.current || item.hasCurrent ? "page" : null}
						href={item.url}
					>
						{item.label}
						{item.hasChildren && (
							<rvt-icon name="chevron-right"></rvt-icon>
						)}
					</a>
				</li>
			))}
		</ul>
	</nav>
</rvt-prototype-section-nav>

<style is:global>
	rvt-prototype-section-nav {
		display: block;

		nav {
			h2 {
				font: var(--rvt-font-16-bold);

				&:not(:first-child) {
					margin-block-start: var(--rvt-size-32);
				}

				a {
					font: inherit;
				}
			}

			a {
				align-items: center;
				color: unset;
				display: flex;
				font: var(--rvt-font-16);
				justify-content: space-between;
				text-decoration: none;

				&:visited {
					color: inherit;
				}

				&:hover {
					color: var(--rvt-color-theme-text-accent);
					text-decoration: underline;
				}

				&[aria-current="page"] {
					color: var(--rvt-color-theme-text-accent);
					font-variation-settings: var(--rvt-font-variation-grade);
					text-decoration: underline;
					text-underline-offset: var(--rvt-size-4);
				}
			}

			> a {
				font: var(--rvt-font-14);
				gap: var(--rvt-size-8);
				justify-content: unset;
			}

			ul {
				border-block-start: var(--rvt-border);
				list-style-type: "";
				margin: 0;
				padding: 0;

				&:not(:first-child) {
					margin-block-start: var(--rvt-size-8);
				}

				li {
					border-block-end: var(--rvt-border);
				}

				a {
					padding: var(--rvt-size-8);
				}
			}
		}

		&[type="main"] {
			a {
				font: var(--rvt-font-16-bold);
				padding-block: var(--rvt-size-4);
				padding-inline: 0;

				rvt-icon {
					display: none;
				}
			}

			ul, li {
				border: none;
			}
		}
	}
</style>
