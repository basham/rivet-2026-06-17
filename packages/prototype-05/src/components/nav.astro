---
const { menus } = Astro.props;
const menu = menus.page.hasChildren ? menus.page : menus.page.getParent();
const parent = menu.getParent();
---

<rvt-prototype-nav>
	<nav>
		{menu.depth > 0 && (
			<>
				<a href={parent.url}>
					<rvt-icon name="chevron-left"></rvt-icon>
					Back to {parent.main ? "Home" : parent.label}
				</a>
				<a
					aria-current={menu.current ? "page" : null}
					data-current={menu.hasCurrent ? true : null}
					href={menu.url}
				>
					{menu.label}
				</a>
			</>
		)}
		<ul>
			{menu.items.map((item: any) => (
				<li>
					<a
						aria-current={item.current ? "page" : null}
						href={item.url}
					>
						{item.label}
						{item.hasChildren && (
							<rvt-icon name="chevron-right"></rvt-icon>
						)}
					</a>
				</li>
			))}
		</ul>

	</nav>
</rvt-prototype-nav>

<style is:global>
	rvt-prototype-nav {
		display: flex;
		flex-direction: column;

		> nav {
			display: flex;
			flex-direction: column;
			flex-grow: 1;
			gap: var(--rvt-size-16);

			> a {
				justify-content: unset;

				&:not(:has(rvt-icon)) {
					font: var(--rvt-font-18);
				}

				&:has(rvt-icon) {
					font: var(--rvt-font-14);
					gap: var(--rvt-size-4);
					padding-block: var(--rvt-size-2);
				}
			}

			ul:first-child {
				gap: var(--rvt-size-16);
				margin-inline-start: 0;

				a {
					font: var(--rvt-font-18);
				}
			}
		}

		:where(ul) {
			display: flex;
			flex-direction: column;
			flex-grow: 1;
			gap: var(--rvt-size-8);
			list-style-type: "";
			margin: 0 0 0 var(--rvt-size-20);
			padding: 0;
		}

		:where(a:not(.rvt-button)) {
			align-items: center;
			color: unset;
			display: flex;
			gap: var(--rvt-size-8);
			justify-content: space-between;
			text-decoration: none;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[aria-current="page"] {
				color: var(--rvt-color-theme-text-accent);
				font-variation-settings: var(--rvt-font-variation-grade);
				text-decoration: underline;
				text-underline-offset: var(--rvt-size-4);
			}
		}

		.rvt-button-group {
			margin-block-start: var(--rvt-size-48);
		}
	}
</style>