---
import SectionNav from "../components/section-nav.astro";
import { site } from "../const.js";
import { getUrl } from "../util.js";

const { menus, theme = "light" } = Astro.props;
---

<rvt-header class={`rvt-theme-${theme}`}>
	<a
		class="rvt-skip-link"
		href="#main-content"
	>
		Skip to main content
	</a>
	<header>
		<a class="rvt-lockup" href={getUrl()}>
			<rvt-logo-iu tab></rvt-logo-iu>
			<div class="rvt-lockup__body">
				<div class="rvt-lockup__title">{site}</div>
			</div>
		</a>
		<button
			class="rvt-button rvt-button--strong rvt-button--icon-only"
			command="show-modal"
			commandfor="rvt-header-menu-dialog"
			data-rvt-header-menu-toggle
		>
			<span class="rvt-sr-only">Browse</span>
		</button>
		<dialog
			aria-labelledby="rvt-header-menu-dialog"
			id="rvt-header-menu-dialog"
		>
			<header>
				<h1 id="rvt-header-menu-dialog-title">
					Menu
				</h1>
				<button
					class="rvt-button rvt-button--icon-only rvt-header__button"
					command="close"
					commandfor="rvt-header-menu-dialog"
				>
					<rvt-icon name="close"></rvt-icon>
					<span class="rvt-sr-only">Close</span>
				</button>
			</header>
			<SectionNav menu={menus.main} />
			{!menus.page.main && (
				<SectionNav menu={menus.page} />
			)}
		</dialog>
		<nav>
			<ul>
				{menus.main.items.map((item: any) => (
					<li>
						<a
							aria-current={(item.current || item.hasCurrent) ? "page" : null}
							href={item.url}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</header>
</rvt-header>

<style is:global>
	body:has(dialog[open]:modal) {
		overflow: hidden;
	}

	rvt-header {
		> header {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			padding: var(--rvt-size-24);

			> nav {
				flex-basis: 100%;

				ul {
					display: flex;
					flex-wrap: wrap;
					gap: var(--rvt-size-8) var(--rvt-size-24);
					list-style-type: "";
					margin: 0;
					padding: 0;
				}

				a {
					color: inherit;
					font: var(--rvt-font-14);
					text-decoration: none;

					&[aria-current="page"] {
						color: var(--rvt-color-theme-text-accent);
						font-variation-settings: var(--rvt-font-variation-grade);
						text-decoration: underline;
					}

					&:hover {
						color: var(--rvt-color-theme-text-accent);
						text-decoration: underline;
					}
				}
			}
		}
	}

	#rvt-header-menu-dialog {
		background-color: var(--rvt-color-theme-background);
		border: none;
		box-shadow: var(--rvt-shadow-heavy);
		height: 100vh;
		inset: auto;
		max-height: unset;
		max-width: 30rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding-block: var(--rvt-size-28);
		padding-inline: var(--rvt-size-24);
		position: fixed;
		right: 0;
		width: 100%;

		&::backdrop {
			background-color: rgba(0, 0, 0, 0.7);
		}

		> header {
			align-items: center;
			display: flex;
			justify-content: space-between;
			margin-block-end: var(--rvt-size-16);

			h1 {
				align-items: center;
				display: flex;
				font: var(--rvt-font-20-bold);
				gap: var(--rvt-size-8);
			}
		}

		rvt-prototype-section-nav {
			margin-block-start: var(--rvt-size-24);

			& + & {
				border-block-start: var(--rvt-border);
				padding-block-start: var(--rvt-size-32);
			}
		}
	}
</style>
