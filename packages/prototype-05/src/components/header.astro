---
import CTA from "../components/cta.astro";
import Nav from "../components/nav.astro";
import Search from "../components/search.astro";
import { site } from "../const.js";
import { getUrl } from "../util.js";

const { menus } = Astro.props;
---

<rvt-header>
	<a
		class="rvt-skip-link"
		href="#main-content"
	>
		Skip to main content
	</a>
	<header>
		<a class="rvt-lockup" href={getUrl()}>
			<rvt-logo-iu tab></rvt-logo-iu>
			<div class="rvt-lockup__body">
				<div class="rvt-lockup__title">{site}</div>
			</div>
		</a>
		<button
			aria-expanded="false"
			class="rvt-button rvt-button--strong rvt-button--icon-only"
			data-rvt-header-menu-toggle
		>
			<span class="rvt-sr-only">Menu</span>
		</button>
		<rvt-prototype-header-menu>
			<Search />
			<Nav menus={menus} />
			<CTA />
		</rvt-prototype-header-menu>
	</header>
</rvt-header>

<style is:global>
	rvt-header {
		background-color: unset;

		> header {
			display: grid;
			gap: 0 var(--rvt-size-24);
			grid-template-areas:
				"lockup button"
				"menu menu";
			grid-template-columns: 1fr auto;
			padding-inline: var(--rvt-size-24);

			&::before {
				display: none;
			}

			> .rvt-lockup {
				grid-area: lockup;
				position: unset;
			}

			> button {
				grid-area: button;
				margin: unset;
				position: unset;
			}

			> rvt-prototype-header-menu {
				display: flex;
				gap: var(--rvt-size-24);
				grid-area: menu;
				flex-direction: column;
				flex-grow: 1;
				justify-self: center;
				max-width: 20rem;
				padding-block-start: var(--rvt-size-24);

				rvt-prototype-nav {
					flex-grow: 1;
				}
			}
		}

		@media (width <= 60rem) {
			> header > button[aria-expanded="false"] ~ * {
				display: none;
			}
		}

		@media (width > 60rem) {
			> header {
				--padding: var(--rvt-size-24);
				align-items: start;
				display: flex;
				flex-direction: column;
				padding-block-end: 0;
				padding-inline-end: calc(var(--padding) - var(--scrollbar-width, var(--rvt-size-16)));

				> button[aria-expanded] {
					display: none;
				}

				> rvt-prototype-header-menu {
					padding-block-end: var(--rvt-size-24);
				}
			}
		}
	}
</style>

<script>
const menuExpanded = window.localStorage.getItem("menu-expanded") ?? "false";
const menuButton = document.querySelector("[data-rvt-header-menu-toggle]");

if (menuButton) {
	menuButton.setAttribute("aria-expanded", menuExpanded);
}

document.addEventListener("click", (event) => {
	if (!(event.target instanceof Element)) {
		return
	};
	const button = event.target.closest("button");
	const attr = "aria-expanded";
	if (button?.hasAttribute(attr)) {
		const value = button.getAttribute(attr);
		const newValue = value === "true" ? "false" : "true";
		console.log(value, newValue);
		button.setAttribute(attr, newValue);
		window.localStorage.setItem("menu-expanded", newValue);
	}
});

const header = document.querySelector("rvt-header") as HTMLElement;
const resizeObserver = new ResizeObserver(() => {
	const scrollbarWidth = header.offsetWidth - header.clientWidth - header.clientLeft;
	header.style.setProperty('--scrollbar-width', `${scrollbarWidth}px`);
});
resizeObserver.observe(header);
</script>
