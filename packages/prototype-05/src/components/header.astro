---
import MobileMenu from "../components/mobile-menu.astro";
import Search from "../components/search.astro";
import { site } from "../const.js";
import { getUrl } from "../util.js";

const { menus } = Astro.props;
---

<rvt-header>
	<a
		class="rvt-skip-link"
		href="#main-content"
	>
		Skip to main content
	</a>
	<header>
		<a class="rvt-lockup" href={getUrl()}>
			<rvt-logo-iu tab></rvt-logo-iu>
			<div class="rvt-lockup__body">
				<div class="rvt-lockup__title">{site}</div>
			</div>
		</a>
		<Search />
		<MobileMenu menus={menus} />
	</header>
</rvt-header>

<style is:global>
	rvt-header {
		> header {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			padding: var(--rvt-size-24);

			> rvt-prototype-search {
				display: none;
			}

			@media (width > 60rem) {
				> rvt-prototype-search {
					display: block;
				}

				> rvt-prototype-mobile-menu {
					display: none;
				}
			}
		}
	}
</style>
