---
import CTA from "../components/cta.astro";
import SectionNav from "../components/section-nav.astro";

const { menus } = Astro.props;
---

<rvt-prototype-nav>
	<nav>
		<ul>
			{menus.main.items.map((item: any) => (
				<li>
					<a
						aria-current={item.current ? "page" : null}
						data-current={item.hasCurrent ? true : null}
						href={item.url}
					>
						{item.label}
					</a>
					{(item.current || item.hasCurrent) && (
						<SectionNav menu={menus.page} />
					)}
				</li>
			))}
		</ul>
		<CTA />
	</nav>
</rvt-prototype-nav>

<style is:global>
	rvt-prototype-nav {
		display: block;

		> nav {
			display: flex;
			height: 100%;
			flex-direction: column;
			justify-content: space-between;

			> ul > li > a {
				font: var(--rvt-font-18);
			}
		}

		:where(ul) {
			display: flex;
			flex-direction: column;
			gap: var(--rvt-size-16);
			list-style-type: "";
			margin: 0;
			padding: 0;
		}

		:where(a:not(.rvt-button)) {
			align-items: center;
			color: unset;
			display: flex;
			gap: var(--rvt-size-8);
			justify-content: space-between;
			text-decoration: none;

			&:visited {
				color: inherit;
			}

			&:hover {
				color: var(--rvt-color-theme-text-accent);
				text-decoration: underline;
			}

			&[data-current] {
				font-variation-settings: var(--rvt-font-variation-grade);
			}

			&[aria-current="page"] {
				color: var(--rvt-color-theme-text-accent);
				font-variation-settings: var(--rvt-font-variation-grade);
				text-decoration: underline;
				text-underline-offset: var(--rvt-size-4);
			}
		}

		.rvt-button-group {
			margin-block-start: var(--rvt-size-48);
		}
	}
</style>