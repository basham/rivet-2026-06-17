---
import { site } from "../const.js";
import { getUrl } from "../util.js";

const { menus } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="rvt-footer">
	<div class="rvt-footer-resources">
		<h2 class="rvt-sr-only">Resources</h2>
		<div class="rvt-footer-resources__contact">
			<h3>
				<a class="rvt-lockup" href={getUrl()}>
					{site}
				</a>
			</h3>
			<p>
				107 S. Indiana Avenue<br>
				Bloomington, IN 47405-7000
			</p>
			<p>
				<a href="tel:8128554848">(812) 855-4848</a>
			</p>
		</div>
		<div class="rvt-footer-resources__links">
			<div>
				<h3>
					Explore
				</h3>
				<ul>
					{menus.main.items.map((item: any) => (
						<li>
							<a
								aria-current={item.current ? "page" : null}
								href={item.url}
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
	<div class="rvt-footer-legal">
		<h2 class="rvt-sr-only">Legal</h2><ul>
			<li>
				<a href="https://accessibility.iu.edu/assistance/"> Accessibility </a>
			</li>
			<li>
				<a href="https://www.iu.edu/college-scorecard.html">
					College Scorecard
				</a>
			</li>
			<li>
				<a href="https://www.iu.edu/open-to-all.html"> Open to All </a>
			</li>
			<li>
				<a href="https://iu.edu/privacy/"> Privacy Notice </a>
			</li>
			<li>
				<a href="https://indianapolis.iu.edu/required-disclosures/">
					Required Disclosures
				</a>
			</li>
			<li>
				<a href="https://iu.edu/copyright/">Copyright</a>
				{` © ${year} The Trustees of `}
				<a href="https://www.iu.edu">Indiana University</a>
			</li>
		</ul>
	</div>
</footer>

<style is:global>
	.rvt-footer {
		padding-inline: var(--padding);

		.rvt-footer-resources {
			column-gap: calc(var(--padding) * 2);
			padding-block: var(--padding);
		}

		.rvt-footer-resources__contact {
			flex-grow: unset;

			h3 a {
				color: var(--rvt-color-theme-text-accent);
			}
		}

		.rvt-footer-resources__links {
			flex-basis: unset;
			flex-grow: unset;
		}

		.rvt-footer-legal {
			padding-block: var(--rvt-size-24);
		}
	}
</style>