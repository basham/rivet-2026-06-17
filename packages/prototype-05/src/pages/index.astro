---
import HeroFigure from "../components/hero-figure.astro";
import Layout from "../layouts/layout.astro";
import { getUrl } from "../util.js";

export const title = "Home";
---

<Layout title={title}>
	<div class="rvt-hero rvt-hero--statement rvt-section">
		<div class="rvt-hero__body">
			<div class="rvt-hero__eyebrow">Metropolitan Zoo</div>
			<h2 class="rvt-hero__title">
				Connect with wildlife from around the world
			</h2>
			<p class="rvt-hero__teaser">
				Explore animal habitats, learn about wildlife protection, and enjoy fun activities with your family every day.
			</p>
			<div class="rvt-hero__actions">
				<a
					class="rvt-button rvt-button--cta rvt-button--strong"
					href={getUrl("plan-your-visit")}
				>
					Plan your visit
				</a>
			</div>
		</div>
		<HeroFigure
			alt="Boy with backpack spreads his arms out wide, enthralled with the fish swimming in front of him on the other side of the room-sized aquarium glass."
			id="home"
		/>
	</div>
</Layout>
