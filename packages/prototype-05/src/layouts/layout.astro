---
import "@rivet-iu/core/dist/rivet.css";
import "@rivet-iu/core/dist/rivet-icons.css";
import "@rivet-iu/core/dist/rivet-stickers.css";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import { menus as _menus, site } from "../const.js";
import { getMenus, getUrl } from "../util.js";

const menus = getMenus(_menus, Astro);
const { page } = menus;
const { label: title, content = {}, ...props } = page;
const root = Astro.url.pathname === getUrl() + "/";
const docTitle = root ? site : [title, site].join(" - ");
const hideTitle = Astro.slots.has("default");
const breadcrumbs = [];

if (page) {
	let parent = page.getParent();
	while (parent) {
		breadcrumbs.unshift(parent);
		parent = parent.getParent();
	}
}

const menu = page.hasChildren ? page : page.getParent();
const menuParent = menu.getParent();
const topMenus = getMenus(_menus, { url: { pathname: "/" } });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
	</head>
	<body>
		<Header menus={topMenus} />
		<div class="layout">
			{
				!root && menu.parent && (
					<rvt-prototype-section-nav>
						<button
							class="rvt-button rvt-button--small"
							popovertarget="rvt-section-nav"
						>
							In this section
							<rvt-icon name="chevron-down"></rvt-icon>
						</button>
						<nav
							aria-label="Section nav"
							id="rvt-section-nav"
							popover
						>
							<a href={menuParent.url}>
								<rvt-icon name="arrow-left"></rvt-icon>
								{menuParent.id === "main" ? "Home" : menuParent.label}
							</a>
							<h2>
								{menu.current && menu.label}
								{!menu.current && (
									<a href={menu.url}>
										{menu.label}
									</a>
								)}
							</h2>
							<ul>
								{menu.items.map((item: any, i: number) => (
									<li>
										<a
											aria-current={item.current ? "page" : null}
											href={item.url}
										>
											{item.label}
											{item.hasChildren && (
												<rvt-icon name="chevron-right"></rvt-icon>
											)}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</rvt-prototype-section-nav>
				)
			}
			{
				!root && (
					<rvt-breadcrumbs>
						<nav aria-label="Breadcrumbs">
							<ol class="rvt-breadcrumbs">
								{breadcrumbs.map((item, i) => (
									<li>
										<a href={item.url}>
											{i === 0 && <span class="rvt-sr-only">Home</span>}
											{i > 0 && item.label}
										</a>
									</li>
								))}
								<li aria-current="page">{title}</li>
							</ol>
						</nav>
					</rvt-breadcrumbs>
				)
			}
			<main id="main-content">
				{
					!hideTitle && (
						<div class:list={{
							"rvt-hero": true,
							"rvt-hero--statement": menus.page.depth === 0,
							"rvt-hero--feature": menus.page.depth === 1,
						}}>
							<div class="rvt-hero__body">
								<h1 class="rvt-hero__title">{content.h1}</h1>
								<p class="rvt-hero__teaser">{content.intro}</p>
							</div>
						</div>
					)
				}
				{hideTitle && <h1 class="rvt-sr-only">{title}</h1>}
				{
					menus.page?.articles && (
						<div class="content">
							{menus.page.articles.map((article: any) => (
								<>
									<h2>{article.label}</h2>
									<p>{article.description}</p>
								</>
							))}
						</div>
					)
				}
				<div class="rvt-rich-text">
					<h2>{content.h2}</h2>
					<p>{content.body}</p>
				</div>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:is(rvt-header, .rvt-footer) .rvt-container {
		max-width: unset;
		padding-inline: var(--rvt-size-24);
	}
</style>

<style is:global>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	.layout {
		display: flex;
		flex-grow: 1;
		flex-wrap: wrap;
	}

	rvt-prototype-section-nav {
		display: block;
		grid-area: section-nav;
		padding-block-end: var(--rvt-size-16);
		padding-inline: var(--rvt-size-24) 0;

		button[popovertarget] {
			anchor-name: --button;
		}

		nav {
			&[popover] {
				border: var(--rvt-border);
				box-shadow: var(--rvt-shadow-standard);
				inset: auto;
				left: anchor(--button left);
				margin: var(--rvt-size-8) 0 0;
				padding: var(--rvt-size-24);
				position: absolute;
				position-anchor: --button;
				top: anchor(--button bottom);
				width: calc(100vw - var(--rvt-size-48));
			}

			h2 {
				font: var(--rvt-font-16-bold);

				&:not(:first-child) {
					margin-block-start: var(--rvt-size-32);
				}

				a {
					font: inherit;
				}
			}

			a {
				align-items: center;
				color: unset;
				display: flex;
				font: var(--rvt-font-16);
				justify-content: space-between;
				text-decoration: none;

				&:visited {
					color: inherit;
				}

				&:hover {
					color: var(--rvt-color-theme-text-accent);
					text-decoration: underline;
				}

				&[aria-current="page"] {
					color: var(--rvt-color-theme-text-accent);
					font-variation-settings: var(--rvt-font-variation-grade);
					text-decoration: underline;
					text-underline-offset: var(--rvt-size-4);
				}
			}

			> a {
				font: var(--rvt-font-14);
				gap: var(--rvt-size-8);
				justify-content: unset;
			}

			ul {
				list-style-type: "";
				margin: 0;
				padding: 0;

				&:not(:first-child) {
					margin-block-start: var(--rvt-size-16);
				}

				li:not(:first-child) {
					margin-block-start: var(--rvt-size-8);
				}
			}
		}
	}

	rvt-breadcrumbs {
		align-self: center;
		display: block;
		grid-area: breadcrumbs;
		padding-block-end: var(--rvt-size-16);
		padding-inline: var(--rvt-size-24);

		nav {
			display: flex;
		}
	}

	main {
		flex-basis: 100%;
		grid-area: main;
		padding-block: var(--rvt-size-8) var(--rvt-size-24);
		padding-inline: var(--rvt-size-24);

		.rvt-hero {
			margin-block-end: var(--rvt-size-24);
			margin-inline: unset;
			padding-inline: 0;
		}

		.content {
			h2 {
				font: var(--rvt-font-20-fluid-black);
				margin-block-start: var(--rvt-size-32);
			}
		}

		.rvt-card-grid {
			--gap: clamp(var(--rvt-size-16), 5vw, var(--rvt-size-40));
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		}
	}

	aside {
		flex-basis: 100%;
		grid-area: aside;
		padding-block: 0 var(--rvt-size-24);
		padding-inline: var(--rvt-size-24);
	}

	footer {
		grid-area: footer;
	}

	@media (width > 50rem) {
		.layout {
			display: grid;
			border-block-start: var(--rvt-border);
			grid-template-areas:
				"breadcrumbs"
				"main"
				"aside";
			grid-template-columns: 1fr;
			grid-template-rows: auto auto 1fr;

			&:has(rvt-prototype-section-nav) {
				grid-template-areas:
					"section-nav breadcrumbs"
					"section-nav main"
					"section-nav aside";
				grid-template-columns: min(30vw, 18rem) 1fr;
			}

			rvt-prototype-section-nav {
				border-inline-end: var(--rvt-border);
				padding: var(--rvt-size-24);

				button[popovertarget] {
					display: none;
				}
			}

			rvt-breadcrumbs {
				padding-block-start: var(--rvt-size-24);
				padding-inline: var(--rvt-size-24);
			}
		}
	}

	@media (width > 80rem) {
		.layout {
			display: grid;
			border-block-start: var(--rvt-border);
			grid-template-areas:
				"breadcrumbs"
				"main"
				"footer";
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;

			&:has(rvt-prototype-section-nav):not(:has(aside)) {
				grid-template-areas:
					"section-nav breadcrumbs"
					"section-nav main"
					"section-nav footer";
				grid-template-columns: 18rem 1fr;
			}

			&:not(:has(rvt-prototype-section-nav)):has(aside) {
				grid-template-areas:
					"breadcrumbs aside"
					"main aside"
					"footer aside";
				grid-template-columns: 1fr 18rem;
			}

			&:has(rvt-prototype-section-nav):has(aside) {
				grid-template-areas:
					"section-nav breadcrumbs ."
					"section-nav main aside"
					"section-nav footer footer";
				grid-template-columns: 18rem 1fr 18rem;
			}

			:is(rvt-breadcrumbs, main) {
				justify-self: center;
				max-width: 80rem;
				padding-inline: var(--rvt-size-48);
				width: 100%;
			}

			rvt-breadcrumbs {
				padding-block-start: var(--rvt-size-48);
			}

			main {
				padding-block-end: var(--rvt-size-48);
			}

			aside {
				padding-block: var(--rvt-size-24) var(--rvt-size-48);
				padding-inline: 0 var(--rvt-size-48);
			}
		}
	}
</style>

<script>
	import "@rivet-iu/core";
</script>

<script>
	const popover = document.getElementById("rvt-section-nav");
	if (popover) {
		popover.addEventListener('beforetoggle', (event) => {
			if (event.newState === 'open') {
				requestAnimationFrame(() => {
					const firstFocusable = popover.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])') as HTMLElement;
					if (firstFocusable) {
						firstFocusable.focus();
					} else {
						popover.focus();
					}
				});
			}
		});

		popover.addEventListener("focusout", (event) => {
			if (!popover.contains(event.relatedTarget as Node)) {
				popover.hidePopover();
			}
		});

		const mq = window.matchMedia("(width > 50rem)");

		function handleViewportChange(matches: Boolean) {
			if (!popover) {
				return;
			}
			if (matches) {
				popover.removeAttribute("popover");
			} else {
				popover.setAttribute("popover", "auto");
				popover.hidePopover();
			}
		}

		handleViewportChange(mq.matches);
		mq.addEventListener("change", (e) => handleViewportChange(e.matches));
	}
</script>
