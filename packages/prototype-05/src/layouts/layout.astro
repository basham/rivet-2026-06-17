---
import "@rivet-iu/core/dist/rivet.css";
import "@rivet-iu/core/dist/rivet-icons.css";
import "@rivet-iu/core/dist/rivet-stickers.css";
import Breadcrumbs from "../components/breadcrumbs.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import HeroFigure from "../components/hero-figure.astro";
import Nav from "../components/nav.astro";
import { menus as _menus, site } from "../const.js";
import { getMenus, getUrl } from "../util.js";

const menus = getMenus(_menus, Astro);
const { page } = menus;
const { label: title, content = {} } = page;
const root = Astro.url.pathname === getUrl() + "/";
const docTitle = root ? site : [title, site].join(" - ");
const hideTitle = Astro.slots.has("default");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
	</head>
	<body>
		<Header menus={menus} />
		<div class="layout">
			<Nav menus={menus} />
			{
				!root && (
					<Breadcrumbs page={page} />
				)
			}
			<main id="main-content">
				{
					!hideTitle && (
						<div class:list={{
							"rvt-hero": true,
							"rvt-hero--statement": menus.page.depth === 0,
							"rvt-hero--feature": menus.page.depth === 1,
						}}>
							<div class="rvt-hero__body">
								<h1 class="rvt-hero__title">{content.h1}</h1>
								<p class="rvt-hero__teaser">{content.intro}</p>
							</div>
							<HeroFigure
								alt={(menus.page.content ?? {})["hero-image"]}
								id={menus.page.id}
							/>
						</div>
					)
				}
				{hideTitle && <h1 class="rvt-sr-only">{title}</h1>}
				{
					menus.page?.articles && (
						<div class="content">
							{menus.page.articles.map((article: any) => (
								<>
									<h2>{article.label}</h2>
									<p>{article.description}</p>
								</>
							))}
						</div>
					)
				}
				<div class="rvt-rich-text">
					<h2>{content.h2}</h2>
					<p>{content.body}</p>
				</div>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:is(rvt-header, .rvt-footer) .rvt-container {
		max-width: unset;
		padding-inline: var(--rvt-size-24);
	}
</style>

<style is:global>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	.layout {
		flex-grow: 1;

		rvt-prototype-nav {
			grid-area: nav;
		}
	}

	rvt-breadcrumbs {
		align-self: center;
		display: block;
		grid-area: breadcrumbs;
		padding-block-end: var(--rvt-size-16);
		padding-inline: var(--rvt-size-24);

		nav {
			display: flex;
		}
	}

	main {
		grid-area: main;
		padding-block: var(--rvt-size-8) var(--rvt-size-24);
		padding-inline: var(--rvt-size-24);

		.rvt-hero {
			margin-block-end: var(--rvt-size-24);
			margin-inline: unset;
			padding-inline: 0;
		}

		.content {
			h2 {
				font: var(--rvt-font-20-fluid-black);
				margin-block-start: var(--rvt-size-32);
			}
		}

		.rvt-card-grid {
			--gap: clamp(var(--rvt-size-16), 5vw, var(--rvt-size-40));
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		}
	}

	footer {
		grid-area: footer;
	}

	@media (width > 50rem) {
		.layout {
			display: grid;
			border-block-start: var(--rvt-border);
			grid-template-areas:
				"breadcrumbs"
				"main"
				"footer";
			grid-template-columns: 1fr;
			grid-template-rows: auto auto 1fr;

			&:has(rvt-prototype-nav) {
				grid-template-areas:
					"nav breadcrumbs"
					"nav main"
					"nav footer";
				grid-template-columns: min(30vw, 20rem) 1fr;
			}

			rvt-prototype-nav {
				border-inline-end: var(--rvt-border);

				button[popovertarget] {
					display: none;
				}
			}

			rvt-breadcrumbs {
				padding-block-start: var(--rvt-size-24);
				padding-inline: var(--rvt-size-24);
			}
		}
	}

	@media (width > 80rem) {
		.layout {
			display: grid;
			border-block-start: var(--rvt-border);
			grid-template-areas:
				"breadcrumbs"
				"main"
				"footer";
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;

			&:has(rvt-prototype-nav) {
				grid-template-areas:
					"nav breadcrumbs"
					"nav main"
					"nav footer";
				grid-template-columns: 20rem 1fr;
			}

			:is(rvt-breadcrumbs, main) {
				justify-self: center;
				max-width: 80rem;
				padding-inline: var(--rvt-size-48);
				width: 100%;
			}

			rvt-breadcrumbs {
				padding-block-start: var(--rvt-size-48);
			}

			main {
				padding-block-end: var(--rvt-size-48);
			}
		}
	}
</style>

<script>
	import "@rivet-iu/core";
</script>
