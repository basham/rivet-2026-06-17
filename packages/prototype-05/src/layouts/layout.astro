---
import "@rivet-iu/core/dist/rivet.css";
import "@rivet-iu/core/dist/rivet-icons.css";
import "@rivet-iu/core/dist/rivet-stickers.css";
import Breadcrumbs from "../components/breadcrumbs.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import HeroFigure from "../components/hero-figure.astro";
import Nav from "../components/nav.astro";
import { menus as _menus, site } from "../const.js";
import { getMenus, getUrl } from "../util.js";

const { content: _content = {} } = Astro.props;
const menus = getMenus(_menus, Astro);
const { page } = menus;
const { label: title, content = _content } = page;
const root = Astro.url.pathname === getUrl() + "/";
const docTitle = root ? site : [title, site].join(" - ");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
	</head>
	<body>
		<Header menus={menus} />
		<div class="layout">
			<Nav menus={menus} />
			{
				!root && (
					<Breadcrumbs page={page} />
				)
			}
			<main id="main-content">
				<div class:list={{
					"rvt-hero": true,
					"rvt-hero--statement": menus.page.depth === 0,
					"rvt-hero--feature": menus.page.depth === 1,
				}}>
					<div class="rvt-hero__body">
						{content.eyebrow && (
							<div class="rvt-hero__eyebrow">{content.eyebrow}</div>
						)}
						<h1 class="rvt-hero__title">{content.h1}</h1>
						<p class="rvt-hero__teaser">{content.intro}</p>
						{content.heroAction && (
							<div class="rvt-hero__actions">
								<a
									class="rvt-button rvt-button--cta rvt-button--strong"
									href={getUrl(content.heroAction.id)}
								>
									{content.heroAction.label}
								</a>
							</div>
						)}
					</div>
					<HeroFigure
						alt={(menus.page.content || content || {})["hero-image"]}
						id={menus.page.id}
					/>
				</div>
				{content.h2 && (
					<div class="rvt-rich-text">
						<h2>{content.h2}</h2>
						<p>{content.body}</p>
					</div>
				)}
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:is(rvt-header, .rvt-footer) .rvt-container {
		max-width: unset;
		padding-inline: var(--rvt-size-24);
	}
</style>

<style is:global>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	.layout {
		--padding: clamp(
			var(--rvt-size-24),
			5vw,
			var(--rvt-size-48)
		);
		border-block-start: var(--rvt-border);
		flex-grow: 1;

		rvt-prototype-nav {
			display: none;
			grid-area: nav;
		}
	}

	rvt-breadcrumbs {
		align-self: center;
		display: block;
		grid-area: breadcrumbs;
		padding-block-start: var(--padding);
		padding-inline: var(--padding);

		nav {
			display: flex;
		}
	}

	main {
		grid-area: main;
		padding: var(--padding);

		.rvt-hero {
			padding-inline: 0;
		}

		.rvt-rich-text {
			margin-block-start: var(--rvt-size-32);
		}
	}

	footer {
		grid-area: footer;
	}

	@media (width > 60rem) {
		.layout {
			display: grid;
			grid-template-areas:
				"nav breadcrumbs"
				"nav main"
				"nav footer";
			grid-template-columns: 20rem 1fr;
			grid-template-rows: auto 1fr auto;

			rvt-prototype-nav {
				border-inline-end: var(--rvt-border);
				display: block;
			}

			:is(rvt-breadcrumbs, main) {
				justify-self: center;
				max-width: 80rem;
				width: 100%;
			}
		}
	}
</style>

<script>
	import "@rivet-iu/core";
</script>
