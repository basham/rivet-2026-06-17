---
import "@rivet-iu/core/dist/rivet.css";
import "@rivet-iu/core/dist/rivet-icons.css";
import Breadcrumbs from "../components/breadcrumbs.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import HeroFigure from "../components/hero-figure.astro";
import { menus as _menus, site } from "../const.js";
import { getMenus, getUrl } from "../util.js";

const { content: _content = {} } = Astro.props;
const menus = getMenus(_menus, Astro);
const { page } = menus;
const { label: title, content = _content } = page;
const root = Astro.url.pathname === getUrl() + "/";
const docTitle = root ? site : [title, site].join(" - ");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{docTitle}</title>
	</head>
	<body>
		<rvt-body>
			<Header menus={menus} />
			<rvt-main>
				{
					!root && (
						<Breadcrumbs page={page} />
					)
				}
				<main id="main-content">
					<div class:list={{
						"rvt-hero": true,
						"rvt-hero--statement": menus.page.depth === 0,
						"rvt-hero--feature": menus.page.depth === 1,
					}}>
						<div class="rvt-hero__body">
							{content.eyebrow && (
								<div class="rvt-hero__eyebrow">{content.eyebrow}</div>
							)}
							<h1 class="rvt-hero__title">{content.h1}</h1>
							<p class="rvt-hero__teaser">{content.intro}</p>
							{content.heroAction && (
								<div class="rvt-hero__actions">
									<a
										class="rvt-button rvt-button--cta rvt-button--strong"
										href={getUrl(content.heroAction.id)}
									>
										{content.heroAction.label}
									</a>
								</div>
							)}
						</div>
						<HeroFigure
							alt={(menus.page.content || content || {})["hero-image"]}
							id={menus.page.id}
						/>
					</div>
					{content.h2 && (
						<div class="rvt-rich-text">
							<h2>{content.h2}</h2>
							<p>{content.body}</p>
						</div>
					)}
				</main>
			</rvt-main>
			<Footer menus={menus} />
		</rvt-body>
	</body>
</html>

<style is:global>
	:root {
		--rvt-color-brand-ultra-light: #fdfaf7;
		--rvt-color-theme-background-light: var(--rvt-color-brand-ultra-light);
	}

	html {
		background-color: var(--rvt-color-theme-background-light);
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	rvt-body {
		--padding: clamp(
			var(--rvt-size-24),
			5vw,
			calc(
				((var(--rvt-graphic-logo-iu-container-height) - var(--rvt-size-20)) / 2)
				+ var(--rvt-size-24)
			)
		);
		display: block;
		flex-grow: 1;

		rvt-header {
			border-block-end: var(--rvt-border);
			grid-area: header;
		}

		rvt-main {
			background: var(--rvt-color-theme-background);
			display: block;
			grid-area: main;
			padding: var(--padding);

			rvt-breadcrumbs {
				align-self: center;
				display: block;
				padding-block-end: var(--padding);

				nav {
					display: flex;
				}
			}

			main {
				grid-area: main;

				.rvt-hero {
					padding-inline: 0;
				}

				.rvt-rich-text {
					margin-block-start: var(--rvt-size-32);
				}
			}
		}

		footer {
			grid-area: footer;
		}
	}

	@media (width > 60rem) {
		rvt-body {
			display: grid;
			grid-template-areas:
				"header main"
				"header main"
				"header footer";
			grid-template-columns: 20rem 1fr;
			grid-template-rows: auto 1fr auto;

			rvt-header {
				border-block-end: none;
				border-inline-end: var(--rvt-border);
				display: flex;
				height: 100vh;
				overflow-y: auto;
				position: sticky;
				scrollbar-gutter: stable;
				top: 0;
			}

			rvt-main {
				padding-inline: max(var(--padding), calc((100% - 90rem) / 2));
			}
		}
	}
</style>

<script>
	import "@rivet-iu/core";
</script>
